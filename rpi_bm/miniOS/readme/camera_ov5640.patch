diff -ruN -x build-t113 miniOS.base/src/boards/100ask_t113/gpio.c miniOS/src/boards/100ask_t113/gpio.c
--- a/rpi_bm/miniOS/src/boards/100ask_t113/gpio.c	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/src/boards/100ask_t113/gpio.c	2026-10-18 14:15:31.294906168 -0500
@@ -0,0 +1,57 @@
+#include "platform.h"
+#include "gpio.h"
+
+#define GPIO_CFG(port, pin)  (T113_PIO_BASE + (port) * T113_GPIO_BANK_STRIDE + \
+                              ((pin) / 8u) * 4u)
+#define GPIO_DAT(port)       (T113_PIO_BASE + (port) * T113_GPIO_BANK_STRIDE + 0x10u)
+#define GPIO_PULL(port, pin) (T113_PIO_BASE + (port) * T113_GPIO_BANK_STRIDE + \
+                              0x24u + ((pin) / 16u) * 4u)
+
+static void rmw(uint32_t addr, uint32_t mask, uint32_t value)
+{
+    mmio_write32(addr, (mmio_read32(addr) & ~mask) | (value & mask));
+}
+
+void t113_gpio_set_function(uint32_t port, uint32_t pin, uint32_t function)
+{
+    uint32_t shift = (pin % 8u) * 4u;
+    rmw(GPIO_CFG(port, pin), 0xfu << shift, function << shift);
+}
+
+uint32_t t113_gpio_get_function(uint32_t port, uint32_t pin)
+{
+    return (mmio_read32(GPIO_CFG(port, pin)) >> ((pin % 8u) * 4u)) & 0xfu;
+}
+
+void t113_gpio_set_pull(uint32_t port, uint32_t pin, uint32_t pull)
+{
+    uint32_t shift = (pin % 16u) * 2u;
+    rmw(GPIO_PULL(port, pin), 0x3u << shift, pull << shift);
+}
+
+void t113_gpio_set_value(uint32_t port, uint32_t pin, uint32_t value)
+{
+    rmw(GPIO_DAT(port), 1u << pin, (value ? 1u : 0u) << pin);
+}
+
+uint32_t t113_gpio_get_value(uint32_t port, uint32_t pin)
+{
+    return (mmio_read32(GPIO_DAT(port)) >> pin) & 1u;
+}
+
+void t113_gpio_direction_output(int gpio, uint32_t value)
+{
+    if (gpio < 0)
+        return;
+    uint32_t port = (uint32_t)gpio / 32u, pin = (uint32_t)gpio % 32u;
+    t113_gpio_set_value(port, pin, value);
+    t113_gpio_set_function(port, pin, T113_GPIO_OUT);
+}
+
+void t113_pinmux_apply(const struct t113_pin *pins, uint32_t count)
+{
+    for (uint32_t i = 0; i < count; ++i) {
+        t113_gpio_set_pull(pins[i].port, pins[i].pin, pins[i].pull);
+        t113_gpio_set_function(pins[i].port, pins[i].pin, pins[i].function);
+    }
+}
diff -ruN -x build-t113 miniOS.base/src/boards/100ask_t113/i2c_core.c miniOS/src/boards/100ask_t113/i2c_core.c
--- a/rpi_bm/miniOS/src/boards/100ask_t113/i2c_core.c	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/src/boards/100ask_t113/i2c_core.c	2026-10-18 14:16:06.590908266 -0500
@@ -0,0 +1,174 @@
+#include "platform.h"
+#include "i2c.h"
+
+static spinlock_t adapters_lock = SPINLOCK_INIT;
+static struct i2c_adapter *adapters[I2C_MAX_ADAPTERS];
+
+/* --------------------------------------------------------------- adapters */
+
+int i2c_add_numbered_adapter(struct i2c_adapter *adap)
+{
+    if (!adap || !adap->algo || !adap->algo->master_xfer ||
+        adap->nr < 0 || adap->nr >= I2C_MAX_ADAPTERS)
+        return -EINVAL;
+    uint32_t flags = spin_lock_irqsave(&adapters_lock);
+    int ret = adapters[adap->nr] ? -EBUSY : 0;
+    if (!ret)
+        adapters[adap->nr] = adap;
+    spin_unlock_irqrestore(&adapters_lock, flags);
+    return ret;
+}
+
+void i2c_del_adapter(struct i2c_adapter *adap)
+{
+    if (!adap || adap->nr < 0 || adap->nr >= I2C_MAX_ADAPTERS)
+        return;
+    uint32_t flags = spin_lock_irqsave(&adapters_lock);
+    if (adapters[adap->nr] == adap)
+        adapters[adap->nr] = 0;
+    spin_unlock_irqrestore(&adapters_lock, flags);
+}
+
+struct i2c_adapter *i2c_get_adapter(int nr)
+{
+    if (nr < 0 || nr >= I2C_MAX_ADAPTERS)
+        return 0;
+    uint32_t flags = spin_lock_irqsave(&adapters_lock);
+    struct i2c_adapter *adap = adapters[nr];
+    spin_unlock_irqrestore(&adapters_lock, flags);
+    return adap;
+}
+
+int i2c_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num)
+{
+    if (!adap || !msgs || num <= 0)
+        return -EINVAL;
+    return adap->algo->master_xfer(adap, msgs, num);
+}
+
+/* -------------------------------------------------------------------- bus */
+
+static const struct i2c_device_id *
+i2c_match_id(const struct i2c_device_id *id, const struct i2c_client *client)
+{
+    if (!id)
+        return 0;
+    for (; id->name; ++id)
+        if (dev_str_eq(id->name, client->name))
+            return id;
+    return 0;
+}
+
+/* compatible, then id_table, then driver name — same order as platform. */
+static int i2c_device_match(struct device *dev, struct device_driver *drv)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct i2c_driver *idrv = to_i2c_driver(drv);
+
+    if (of_match_compatible(idrv->of_match_table, client->compatible))
+        return 1;
+    if (idrv->id_table)
+        return i2c_match_id(idrv->id_table, client) != 0;
+    return dev_str_eq(client->name, drv->name);
+}
+
+/*
+ * Bus-level probe: besides the type conversion, this is where the I2C core
+ * resolves the client's adapter. A chip driver's probe can therefore always
+ * use client->adapter; if the controller has not probed yet the bind fails
+ * with -ENODEV and can be retried later with device_attach().
+ */
+static int i2c_device_probe(struct device *dev)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct i2c_driver *idrv = to_i2c_driver(dev->driver);
+
+    client->adapter = i2c_get_adapter(client->adapter_nr);
+    if (!client->adapter) {
+        t113_uart_puts(dev_name(dev));
+        t113_uart_puts(": i2c adapter not registered yet\n");
+        return -ENODEV;
+    }
+    client->of_match = of_match_compatible(idrv->of_match_table,
+                                           client->compatible);
+    client->id_entry = i2c_match_id(idrv->id_table, client);
+
+    int ret = idrv->probe ? idrv->probe(client) : 0;
+    if (ret < 0) {
+        client->adapter = 0;
+        client->of_match = 0;
+        client->id_entry = 0;
+    }
+    return ret;
+}
+
+static void i2c_device_remove(struct device *dev)
+{
+    struct i2c_client *client = to_i2c_client(dev);
+    struct i2c_driver *idrv = to_i2c_driver(dev->driver);
+
+    if (idrv->remove)
+        idrv->remove(client);
+    client->adapter = 0;
+    client->of_match = 0;
+    client->id_entry = 0;
+}
+
+struct bus_type i2c_bus_type = {
+    .name = "i2c",
+    .match = i2c_device_match,
+    .probe = i2c_device_probe,
+    .remove = i2c_device_remove,
+};
+
+int i2c_bus_init(void)
+{
+    return bus_register(&i2c_bus_type);
+}
+
+static void format_client_name(struct i2c_client *client)
+{
+    static const char hex[] = "0123456789abcdef";
+    char *p = client->dev_name;
+    *p++ = (char)('0' + client->adapter_nr % 10u);
+    *p++ = '-';
+    for (int shift = 12; shift >= 0; shift -= 4)
+        *p++ = hex[(client->addr >> shift) & 0xfu];
+    *p = '\0';
+}
+
+int i2c_new_client_device(struct i2c_client *client, struct device *parent)
+{
+    if (!client || !client->name || client->addr > 0x7fu ||
+        client->adapter_nr >= I2C_MAX_ADAPTERS)
+        return -EINVAL;
+    format_client_name(client);
+    client->dev.name = client->dev_name;
+    client->dev.parent = parent;
+    client->dev.bus = &i2c_bus_type;
+    client->dev.platform_data = client->platform_data;
+    client->adapter = 0;
+    client->of_match = 0;
+    client->id_entry = 0;
+    return device_register(&client->dev);
+}
+
+void i2c_unregister_device(struct i2c_client *client)
+{
+    if (client)
+        device_unregister(&client->dev);
+}
+
+int i2c_driver_register(struct i2c_driver *drv)
+{
+    if (!drv || !drv->driver.name)
+        return -EINVAL;
+    drv->driver.bus = &i2c_bus_type;
+    return driver_register(&drv->driver);
+}
+
+void i2c_driver_unregister(struct i2c_driver *drv)
+{
+    if (drv)
+        driver_unregister(&drv->driver);
+}
diff -ruN -x build-t113 miniOS.base/src/boards/100ask_t113/ov5640.c miniOS/src/boards/100ask_t113/ov5640.c
--- a/rpi_bm/miniOS/src/boards/100ask_t113/ov5640.c	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/src/boards/100ask_t113/ov5640.c	2026-10-18 14:17:30.122913231 -0500
@@ -0,0 +1,148 @@
+/*
+ * OmniVision OV5640 (DVP) sensor — framework stage.
+ *
+ * SCCB = I2C with 16-bit register addresses and 8-bit data, 7-bit address
+ * 0x3c (0x78 in Allwinner's 8-bit notation). Probe runs the power-up
+ * sequence (if PWDN/RESET are wired to GPIOs), checks that the CSI master
+ * clock is running and reads the chip ID (0x300a/0x300b = 0x56 0x40).
+ * No streaming register tables are written yet.
+ */
+#include "platform.h"
+#include "i2c.h"
+#include "gpio.h"
+#include "camera.h"
+#include "board.h"
+
+#define OV5640_REG_CHIP_ID_HIGH 0x300au
+#define OV5640_REG_CHIP_ID_LOW  0x300bu
+#define OV5640_REG_REVISION     0x302au
+
+struct ov5640 {
+    struct i2c_client *client;
+    uint32_t chip_id;
+    uint8_t revision;
+};
+
+static struct ov5640 ov5640_sensor;
+
+int ov5640_read_reg(struct i2c_client *client, uint16_t reg, uint8_t *val)
+{
+    uint8_t addr[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+    struct i2c_msg msgs[2] = {
+        { .addr = client->addr, .flags = 0, .len = 2, .buf = addr },
+        { .addr = client->addr, .flags = I2C_M_RD, .len = 1, .buf = val },
+    };
+    int ret = i2c_transfer(client->adapter, msgs, 2);
+    return ret == 2 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+int ov5640_write_reg(struct i2c_client *client, uint16_t reg, uint8_t val)
+{
+    uint8_t buf[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, val };
+    struct i2c_msg msg = {
+        .addr = client->addr, .flags = 0, .len = 3, .buf = buf,
+    };
+    int ret = i2c_transfer(client->adapter, &msg, 1);
+    return ret == 1 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+/* Datasheet power-up: PWDN high/RESET low -> MCLK -> PWDN low -> RESET high. */
+static void ov5640_power_on(const struct ov5640_platform_data *pdata)
+{
+    if (pdata->pwdn_gpio < 0 && pdata->reset_gpio < 0) {
+        t113_mdelay(20);            /* hard-wired: just let it settle */
+        return;
+    }
+    t113_gpio_direction_output(pdata->pwdn_gpio, 1);
+    t113_gpio_direction_output(pdata->reset_gpio, 0);
+    t113_mdelay(5);
+    t113_gpio_direction_output(pdata->pwdn_gpio, 0);
+    t113_mdelay(1);
+    t113_gpio_direction_output(pdata->reset_gpio, 1);
+    t113_mdelay(20);
+}
+
+static void ov5640_power_off(const struct ov5640_platform_data *pdata)
+{
+    t113_gpio_direction_output(pdata->reset_gpio, 0);
+    t113_gpio_direction_output(pdata->pwdn_gpio, 1);
+}
+
+static int ov5640_probe(struct i2c_client *client)
+{
+    const struct ov5640_platform_data *pdata = client->platform_data;
+    uint8_t hi = 0, lo = 0, rev = 0;
+    int ret;
+
+    if (!pdata)
+        return -EINVAL;
+    if (!t113_csi_mclk_running(pdata->csi_id)) {
+        t113_uart_puts(dev_name(&client->dev));
+        t113_uart_puts(": csi MCLK not running (csi driver not bound?)\n");
+        return -ENODEV;
+    }
+
+    ov5640_power_on(pdata);
+
+    ret = ov5640_read_reg(client, OV5640_REG_CHIP_ID_HIGH, &hi);
+    if (!ret)
+        ret = ov5640_read_reg(client, OV5640_REG_CHIP_ID_LOW, &lo);
+    if (ret < 0) {
+        t113_uart_puts(dev_name(&client->dev));
+        t113_uart_puts(ret == -ENXIO ? ": no ACK at 0x3c (check PE jumpers"
+                                       " CSI vs EMAC, sensor power)\n"
+                                     : ": SCCB transfer failed\n");
+        ov5640_power_off(pdata);
+        return ret;
+    }
+
+    uint32_t id = ((uint32_t)hi << 8) | lo;
+    if (id != OV5640_CHIP_ID) {
+        t113_uart_puts(dev_name(&client->dev));
+        t113_uart_puts(": unexpected chip id ");
+        t113_uart_puthex(id);
+        t113_uart_putc('\n');
+        ov5640_power_off(pdata);
+        return -ENODEV;
+    }
+    ov5640_read_reg(client, OV5640_REG_REVISION, &rev);
+
+    ov5640_sensor.client = client;
+    ov5640_sensor.chip_id = id;
+    ov5640_sensor.revision = rev;
+    i2c_set_clientdata(client, &ov5640_sensor);
+
+    t113_uart_puts(dev_name(&client->dev));
+    t113_uart_puts(": OV5640 detected on ");
+    t113_uart_puts(client->adapter->name);
+    t113_uart_puts(", chip id ");
+    t113_uart_puthex(id);
+    t113_uart_puts(" rev ");
+    t113_uart_puthex(rev);
+    t113_uart_putc('\n');
+    return 0;
+}
+
+static void ov5640_remove(struct i2c_client *client)
+{
+    ov5640_power_off(client->platform_data);
+    ov5640_sensor.client = 0;
+}
+
+static const struct of_device_id ov5640_of_match[] = {
+    { .compatible = "ovti,ov5640" },
+    { 0 },
+};
+
+static const struct i2c_device_id ov5640_id[] = {
+    { "ov5640", 0 },
+    { 0, 0 },
+};
+
+struct i2c_driver ov5640_driver = {
+    .probe = ov5640_probe,
+    .remove = ov5640_remove,
+    .driver = { .name = "ov5640" },
+    .of_match_table = ov5640_of_match,
+    .id_table = ov5640_id,
+};
diff -ruN -x build-t113 miniOS.base/src/boards/100ask_t113/twi.c miniOS/src/boards/100ask_t113/twi.c
--- a/rpi_bm/miniOS/src/boards/100ask_t113/twi.c	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/src/boards/100ask_t113/twi.c	2026-10-18 14:16:49.194910798 -0500
@@ -0,0 +1,233 @@
+/*
+ * Allwinner TWI (I2C) controller, sun6i-a31 / sun20i-d1 flavour of the
+ * Marvell mv64xxx core, driven by polling (no IRQ). Each probed controller
+ * registers a numbered i2c_adapter; the TWI index is derived from the MMIO
+ * base so "twi2" becomes i2c adapter 2.
+ *
+ * Differences from the classic mv64xxx that matter here:
+ *   - INT_FLAG is write-1-to-clear (writing it also lets the state machine
+ *     continue), and
+ *   - SCL = Fin / (10 * (M + 1) * 2^N)   (N base 0), Fin = APB1 = 24 MHz.
+ */
+#include "platform.h"
+#include "platform_device.h"
+#include "i2c.h"
+#include "twi.h"
+#include "board.h"
+
+#define TWI_ADDR    0x00u
+#define TWI_XADDR   0x04u
+#define TWI_DATA    0x08u
+#define TWI_CNTR    0x0cu
+#define TWI_STAT    0x10u
+#define TWI_CCR     0x14u
+#define TWI_SRST    0x18u
+#define TWI_EFR     0x1cu
+#define TWI_LCR     0x20u
+
+#define CNTR_A_ACK      (1u << 2)
+#define CNTR_INT_FLAG   (1u << 3)
+#define CNTR_M_STP      (1u << 4)
+#define CNTR_M_STA      (1u << 5)
+#define CNTR_BUS_EN     (1u << 6)
+
+#define STAT_START          0x08u
+#define STAT_RESTART        0x10u
+#define STAT_ADDR_W_ACK     0x18u
+#define STAT_ADDR_W_NACK    0x20u
+#define STAT_DATA_W_ACK     0x28u
+#define STAT_ADDR_R_ACK     0x40u
+#define STAT_ADDR_R_NACK    0x48u
+#define STAT_DATA_R_ACK     0x50u
+#define STAT_DATA_R_NACK    0x58u
+#define STAT_IDLE           0xf8u
+
+#define TWI_APB_HZ      24000000u
+#define TWI_TIMEOUT_US  10000u
+
+struct t113_twi {
+    uint32_t base;
+    struct i2c_adapter adap;
+};
+
+static struct t113_twi twi_ctrl[I2C_MAX_ADAPTERS];
+
+static const char *const twi_names[I2C_MAX_ADAPTERS] = {
+    "twi0", "twi1", "twi2", "twi3",
+};
+
+static inline uint32_t twi_rd(struct t113_twi *t, uint32_t reg)
+{
+    return mmio_read32(t->base + reg);
+}
+
+static inline void twi_wr(struct t113_twi *t, uint32_t reg, uint32_t v)
+{
+    mmio_write32(t->base + reg, v);
+}
+
+static int twi_wait_flag(struct t113_twi *t)
+{
+    for (uint32_t us = 0; us < TWI_TIMEOUT_US; ++us) {
+        if (twi_rd(t, TWI_CNTR) & CNTR_INT_FLAG)
+            return 0;
+        t113_udelay(1);
+    }
+    return -ETIMEDOUT;
+}
+
+/* Kick the state machine with `bits` (clearing a pending INT_FLAG). */
+static int twi_step(struct t113_twi *t, uint32_t bits, uint32_t expect)
+{
+    twi_wr(t, TWI_CNTR, CNTR_BUS_EN | CNTR_INT_FLAG | bits);
+    if (twi_wait_flag(t) < 0)
+        return -ETIMEDOUT;
+    return twi_rd(t, TWI_STAT) == expect ? 0 : -EIO;
+}
+
+static void twi_stop(struct t113_twi *t)
+{
+    twi_wr(t, TWI_CNTR, CNTR_BUS_EN | CNTR_INT_FLAG | CNTR_M_STP);
+    for (uint32_t us = 0; us < TWI_TIMEOUT_US; ++us) {
+        if (!(twi_rd(t, TWI_CNTR) & CNTR_M_STP) &&
+            twi_rd(t, TWI_STAT) == STAT_IDLE)
+            return;
+        t113_udelay(1);
+    }
+}
+
+static int twi_start(struct t113_twi *t, int repeated)
+{
+    if (!repeated) {
+        /* First START: no INT_FLAG pending, so don't write it. */
+        twi_wr(t, TWI_CNTR, CNTR_BUS_EN | CNTR_M_STA);
+        if (twi_wait_flag(t) < 0)
+            return -ETIMEDOUT;
+        return twi_rd(t, TWI_STAT) == STAT_START ? 0 : -EIO;
+    }
+    return twi_step(t, CNTR_M_STA, STAT_RESTART);
+}
+
+static int twi_xfer_msg(struct t113_twi *t, struct i2c_msg *msg, int first)
+{
+    int read = (msg->flags & I2C_M_RD) != 0;
+    int ret = twi_start(t, !first);
+    if (ret < 0)
+        return ret;
+
+    twi_wr(t, TWI_DATA, (uint32_t)(msg->addr << 1) | (read ? 1u : 0u));
+    ret = twi_step(t, 0, read ? STAT_ADDR_R_ACK : STAT_ADDR_W_ACK);
+    if (ret < 0)
+        return ret == -EIO ? -ENXIO : ret;      /* address NACK: no chip */
+
+    for (uint16_t i = 0; i < msg->len; ++i) {
+        if (read) {
+            int last = i + 1u == msg->len;
+            ret = twi_step(t, last ? 0 : CNTR_A_ACK,
+                           last ? STAT_DATA_R_NACK : STAT_DATA_R_ACK);
+            if (ret < 0)
+                return ret;
+            msg->buf[i] = (uint8_t)twi_rd(t, TWI_DATA);
+        } else {
+            twi_wr(t, TWI_DATA, msg->buf[i]);
+            ret = twi_step(t, 0, STAT_DATA_W_ACK);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    return 0;
+}
+
+static int twi_master_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+                           int num)
+{
+    struct t113_twi *t = adap->algo_data;
+    int ret = 0;
+
+    for (int i = 0; i < num && ret == 0; ++i)
+        ret = twi_xfer_msg(t, &msgs[i], i == 0);
+    twi_stop(t);
+    return ret < 0 ? ret : num;
+}
+
+static const struct i2c_algorithm twi_algo = {
+    .master_xfer = twi_master_xfer,
+};
+
+/* Pick M (4 bits) and N (3 bits) for the requested SCL rate. */
+static uint32_t twi_ccr(uint32_t hz)
+{
+    for (uint32_t n = 0; n < 8u; ++n) {
+        uint32_t div = 10u * (1u << n) * hz;
+        uint32_t m = (TWI_APB_HZ + div - 1u) / div;     /* round SCL down */
+        if (m >= 1u && m - 1u <= 15u)
+            return ((m - 1u) << 3) | n;
+    }
+    return (15u << 3) | 7u;
+}
+
+static int t113_twi_probe(struct platform_device *pdev)
+{
+    const struct t113_twi_platform_data *pdata = pdev->dev.platform_data;
+    const struct resource *mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+
+    if (!mem || mem->start < T113_TWI0_BASE ||
+        (mem->start - T113_TWI0_BASE) % T113_TWI_STRIDE)
+        return -ENODEV;
+    uint32_t idx = (mem->start - T113_TWI0_BASE) / T113_TWI_STRIDE;
+    if (idx >= I2C_MAX_ADAPTERS)
+        return -ENODEV;
+
+    struct t113_twi *t = &twi_ctrl[idx];
+    t->base = mem->start;
+
+    /* Bus clock gate on, reset deasserted. */
+    uint32_t bgr = mmio_read32(T113_CCU_TWI_BGR);
+    mmio_write32(T113_CCU_TWI_BGR, bgr & ~(1u << (16u + idx)));
+    mmio_write32(T113_CCU_TWI_BGR, bgr | (1u << idx) | (1u << (16u + idx)));
+
+    if (pdata)
+        t113_pinmux_apply(pdata->pins, pdata->num_pins);
+
+    twi_wr(t, TWI_SRST, 1u);
+    for (uint32_t us = 0; us < TWI_TIMEOUT_US && (twi_rd(t, TWI_SRST) & 1u); ++us)
+        t113_udelay(1);
+    twi_wr(t, TWI_CCR, twi_ccr(pdata && pdata->bus_hz ? pdata->bus_hz : 100000u));
+    twi_wr(t, TWI_EFR, 0);
+    twi_wr(t, TWI_CNTR, CNTR_BUS_EN);
+
+    t->adap.nr = (int)idx;
+    t->adap.name = twi_names[idx];
+    t->adap.algo = &twi_algo;
+    t->adap.algo_data = t;
+    t->adap.dev = &pdev->dev;
+    int ret = i2c_add_numbered_adapter(&t->adap);
+    if (ret < 0)
+        return ret;
+
+    platform_set_drvdata(pdev, &t->adap);
+    platform_dev_info(pdev, "i2c adapter registered, polling mode");
+    return 0;
+}
+
+static void t113_twi_remove(struct platform_device *pdev)
+{
+    struct i2c_adapter *adap = platform_get_drvdata(pdev);
+    struct t113_twi *t = adap->algo_data;
+
+    i2c_del_adapter(adap);
+    twi_wr(t, TWI_CNTR, 0);
+}
+
+static const struct of_device_id t113_twi_of_match[] = {
+    { .compatible = "allwinner,sun20i-d1-i2c" },
+    { .compatible = "allwinner,sun6i-a31-i2c" },
+    { 0 },
+};
+
+struct platform_driver t113_twi_driver = {
+    .probe = t113_twi_probe,
+    .remove = t113_twi_remove,
+    .driver = { .name = "mv64xxx_i2c" },
+    .of_match_table = t113_twi_of_match,
+};

diff -ruN -x build-t113 miniOS.base/include/t113/gpio.h miniOS/include/t113/gpio.h
--- a/rpi_bm/miniOS/include/t113/gpio.h	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/include/t113/gpio.h	2026-10-18 14:15:24.450905761 -0500
@@ -0,0 +1,48 @@
+#ifndef MINIOS_T113_GPIO_H
+#define MINIOS_T113_GPIO_H
+
+#include <stdint.h>
+
+/*
+ * Minimal sun20i-d1 / sun8iw20 PIO helpers (bank stride 0x30):
+ *   +0x00..0x0c CFG0..3  4 bits/pin   function select (0 in, 1 out, 2.. alt)
+ *   +0x10       DAT      1 bit/pin
+ *   +0x14..0x20 DRV0..3  4 bits/pin
+ *   +0x24..0x28 PULL0..1 2 bits/pin   0 none, 1 up, 2 down
+ */
+
+enum t113_gpio_port {
+    T113_PB = 1, T113_PC, T113_PD, T113_PE, T113_PF, T113_PG,
+};
+
+#define T113_GPIO_IN        0u
+#define T113_GPIO_OUT       1u
+#define T113_GPIO_DISABLED  0xfu
+
+#define T113_PULL_NONE      0u
+#define T113_PULL_UP        1u
+#define T113_PULL_DOWN      2u
+
+/* Encode a pin as one number (port * 32 + pin), -1 = not connected. */
+#define T113_GPIO(port, pin) ((int)((port) * 32 + (pin)))
+#define T113_GPIO_NONE       (-1)
+
+struct t113_pin {
+    uint8_t port;
+    uint8_t pin;
+    uint8_t function;
+    uint8_t pull;
+};
+
+void t113_gpio_set_function(uint32_t port, uint32_t pin, uint32_t function);
+uint32_t t113_gpio_get_function(uint32_t port, uint32_t pin);
+void t113_gpio_set_pull(uint32_t port, uint32_t pin, uint32_t pull);
+void t113_gpio_set_value(uint32_t port, uint32_t pin, uint32_t value);
+uint32_t t113_gpio_get_value(uint32_t port, uint32_t pin);
+
+/* gpio = T113_GPIO(port, pin); ignored when gpio < 0. */
+void t113_gpio_direction_output(int gpio, uint32_t value);
+
+void t113_pinmux_apply(const struct t113_pin *pins, uint32_t count);
+
+#endif
diff -ruN -x build-t113 miniOS.base/include/t113/i2c.h miniOS/include/t113/i2c.h
--- a/rpi_bm/miniOS/include/t113/i2c.h	1969-12-31 18:00:00.000000000 -0600
+++ b/rpi_bm/miniOS/include/t113/i2c.h	2026-10-18 14:15:51.042907342 -0500
@@ -0,0 +1,100 @@
+#ifndef MINIOS_T113_I2C_H
+#define MINIOS_T113_I2C_H
+
+#include "device.h"
+
+/*
+ * Lightweight I2C core, Linux-shaped:
+ *   i2c_adapter : a bus master (registered by a controller driver's probe)
+ *   i2c_client  : a chip at an address on adapter N (a struct device on the
+ *                 "i2c" bus, normally declared by the board file)
+ *   i2c_driver  : chip driver, matched by compatible / id_table / name
+ *
+ * Adapters are kept in a small numbered table rather than being devices
+ * themselves, so a controller probe can register one without re-entering
+ * the driver core (see the locking note in device.h).
+ */
+
+#define I2C_M_RD        0x0001u
+
+struct i2c_msg {
+    uint16_t addr;              /* 7-bit address */
+    uint16_t flags;             /* I2C_M_RD for a read */
+    uint16_t len;
+    uint8_t *buf;
+};
+
+struct i2c_adapter;
+
+struct i2c_algorithm {
+    /* Returns number of messages transferred, or a negative error. */
+    int (*master_xfer)(struct i2c_adapter *adap, struct i2c_msg *msgs,
+                       int num);
+};
+
+#define I2C_MAX_ADAPTERS 4
+
+struct i2c_adapter {
+    int nr;
+    const char *name;
+    const struct i2c_algorithm *algo;
+    void *algo_data;
+    struct device *dev;         /* controller device (e.g. platform twi2) */
+};
+
+int i2c_add_numbered_adapter(struct i2c_adapter *adap);
+void i2c_del_adapter(struct i2c_adapter *adap);
+struct i2c_adapter *i2c_get_adapter(int nr);
+int i2c_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num);
+
+struct i2c_device_id {
+    const char *name;
+    uint32_t driver_data;
+};
+
+struct i2c_client {
+    const char *name;           /* chip name, e.g. "ov5640" */
+    const char *compatible;     /* e.g. "ovti,ov5640" */
+    uint16_t addr;              /* 7-bit */
+    uint8_t adapter_nr;
+    void *platform_data;
+    struct device dev;
+
+    /* set by the core */
+    char dev_name[12];          /* "<bus>-<addr>", e.g. "2-003c" */
+    struct i2c_adapter *adapter;            /* valid while bound */
+    const struct of_device_id *of_match;
+    const struct i2c_device_id *id_entry;
+};
+
+struct i2c_driver {
+    int (*probe)(struct i2c_client *client);
+    void (*remove)(struct i2c_client *client);
+    struct device_driver driver;
+    const struct of_device_id *of_match_table;
+    const struct i2c_device_id *id_table;
+};
+
+#define to_i2c_client(d) container_of(d, struct i2c_client, dev)
+#define to_i2c_driver(d) container_of(d, struct i2c_driver, driver)
+
+extern struct bus_type i2c_bus_type;
+
+int i2c_bus_init(void);
+/* parent: the controller's struct device (gives /devices/.../twi2/2-003c). */
+int i2c_new_client_device(struct i2c_client *client, struct device *parent);
+void i2c_unregister_device(struct i2c_client *client);
+int i2c_driver_register(struct i2c_driver *drv);
+void i2c_driver_unregister(struct i2c_driver *drv);
+
+static inline void i2c_set_clientdata(struct i2c_client *c, void *data)
+{
+    dev_set_drvdata(&c->dev, data);
+}
+
+static inline void *i2c_get_clientdata(const struct i2c_client *c)
+{
+    return dev_get_drvdata(&c->dev);
+}
+
+#endif

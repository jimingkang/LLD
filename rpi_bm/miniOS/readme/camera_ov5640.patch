+const struct of_device_id *of_match_compatible(const struct of_device_id *table,
+                                               const char *compatible)
+{
+    if (!table || !compatible)
+        return 0;
+    for (; table->compatible; ++table)
+        if (names_match(table->compatible, compatible))
+            return table;

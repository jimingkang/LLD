menu "XRadio wireless support"
    depends on WLAN && SDIO
config WLAN_XRADIO
    bool "XRadio XR8xx support"
    default y if BOARD_100ASK_T113
config WLAN_XRADIO_XR829
    bool "XR829 SDIO device"
    depends on WLAN_XRADIO
    default y
config XR829_WSM
    bool "WSM firmware command layer"
    depends on WLAN_XRADIO_XR829
    default y
config WPA2_PSK
    bool "WPA2-PSK host supplicant primitives"
    depends on XR829_WSM
    default y
endmenu
